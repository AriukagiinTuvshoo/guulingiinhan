APP_ENV=development
DATABASE_URL=postgresql+psycopg://guulingiinhan:change-me@localhost:5432/guulingiinhan
CORS_ORIGINS=http://localhost:3000

# Phone ownership challenges. Generate with: openssl rand -hex 32
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
# Verify.MN is a backend-only secret. The user sends the displayed SMS to 144773;
# the account flow polls Verify.MN from the backend. It is never used for normal login.
VERIFY_MN_API_KEY=
# Normal login uses email or phone + password. No SMS is sent during login.
# Legacy Twilio OTP endpoints remain for compatibility; fake is local/test only.
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google OpenID Connect; leave disabled until credentials are configured.
GOOGLE_OIDC_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OIDC_ISSUER=https://accounts.google.com
# Generate a random 32+ character secret; production requires it when OIDC is enabled.
GOOGLE_OIDC_STATE_SECRET=

# Email delivery; fake is development/test only. Production uses authenticated SMTP.
EMAIL_PROVIDER=fake
EMAIL_FROM=
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
# Trust Cloudflare's client IP header only behind the private Cloudflare Container ingress.
TRUST_CLOUDFLARE_PROXY_IP=false
