APP_ENV=development
DATABASE_URL=postgresql+psycopg://guulingiinhan:change-me@localhost:5432/guulingiinhan
CORS_ORIGINS=http://localhost:3000

# Phone OTP. Generate a production value with: openssl rand -hex 32
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
# Fake is test/development-only and the auth UI stays hidden until real SMS is configured.
# Production must use Twilio with all credentials set.
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google OpenID Connect; leave disabled until credentials are configured.
GOOGLE_OIDC_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OIDC_ISSUER=https://accounts.google.com
# Generate a random 32+ character secret; production requires it when OIDC is enabled.
GOOGLE_OIDC_STATE_SECRET=

# Email delivery; fake is development/test only. Production uses authenticated SMTP.
EMAIL_PROVIDER=fake
EMAIL_FROM=
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
