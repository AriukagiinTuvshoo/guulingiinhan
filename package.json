{
  "name": "guuliinhan-family-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/verify-production-env.mjs && next build",
    "cf:build:staging": "cross-env NEXT_PUBLIC_API_BASE_URL=https://guulingiinhan-backend-staging.tuvshoo0331.workers.dev/api/v1 opennextjs-cloudflare build --config wrangler.staging.jsonc",
    "cf:preview:staging": "cross-env NEXT_PUBLIC_API_BASE_URL=https://guulingiinhan-backend-staging.tuvshoo0331.workers.dev/api/v1 opennextjs-cloudflare preview --config wrangler.staging.jsonc",
    "deploy:staging": "npm run cf:build:staging && opennextjs-cloudflare deploy --config wrangler.staging.jsonc --keep-vars",
    "typecheck": "tsc --noEmit",
    "start": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "latest",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  }
}
