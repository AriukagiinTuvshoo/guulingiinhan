{
  "name": "guuliinhan-family-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/verify-production-env.mjs && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test:tree-3d": "node scripts/verify-tree-3d-layout.mjs",
    "test:family-map": "node scripts/verify-family-map.mjs",
    "test:family-map-browser": "node scripts/verify-family-map-browser.mjs",
    "test:integrated-browser": "node scripts/verify-integrated-browser.mjs",
    "test:mobile-admin": "node scripts/verify-mobile-admin.mjs",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "test:root-linking": "node --experimental-strip-types scripts/verify-root-linking.mjs",
    "test:heritage": "node --experimental-strip-types scripts/verify-heritage-readiness.mjs",
    "regression:routes": "node scripts/verify-core-routes.mjs",
    "start": "next start --hostname 0.0.0.0",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "node scripts/verify-production-env.mjs && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "node scripts/verify-production-env.mjs && vinext-cloudflare deploy",
    "deploy:staging": "node scripts/verify-production-env.mjs && vinext-cloudflare deploy"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vinext/cloudflare": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.5",
    "typescript": "^7.0.2",
    "vinext": "^1.0.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "fflate": "0.7.5",
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  }
}
