{
  "name": "guuliinhan-family-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/verify-production-env.mjs && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start --hostname 0.0.0.0",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "node scripts/verify-production-env.mjs && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "node scripts/verify-production-env.mjs && vinext-cloudflare deploy",
    "deploy:staging": "node scripts/verify-production-env.mjs && vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0",
    "lucide-react": "latest",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
