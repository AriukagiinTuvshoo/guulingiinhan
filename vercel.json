{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/docs",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/openapi.json",
      "destination": "backend/app/main.py"
    }
  ]
}
